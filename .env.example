# Spotify developer application credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify Web API private cookie value used by LibreLyrics Spotify plugin
SPOTIFY_SP_DC=

# Spotify Web API user authorization callback (must be added to your Spotify app Redirect URIs)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Optional OAuth token cache path
SPOTIFY_OAUTH_CACHE=state/spotify_oauth.json
